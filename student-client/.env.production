DISABLE_ESLINT_PLUGIN=true
CI=false
# Khi deploy chung server (all-in-one): để trống hoặc /api → dùng relative URL
# Khi deploy riêng (client tách biệt): đặt full URL của server API
# Ví dụ: REACT_APP_API_URL=https://your-api-server.onrender.com/api
REACT_APP_API_URL=/api
# PUBLIC_URL cho student-client khi deploy chung server
PUBLIC_URL=/student
